{
  "name": "whatsapp-reminder-assistant",
  "version": "1.0.0",
  "type": "module",
  "description": "Hermes TempleLabs — AI-powered WhatsApp executive personal assistant and second brain",
  "main": "src/app/server.js",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "start": "node src/app/server.js",
    "dev": "node --watch src/app/server.js",
    "chat": "node scripts/dev/interactive-chat.js",
    "memory:reindex": "node scripts/maintenance/reindex-memory-embeddings.js",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config tests/config/vitest.unit.js",
    "test:pure": "vitest run --config tests/config/vitest.pure.js",
    "test:component": "vitest run --config tests/config/vitest.component.js",
    "test:regression": "vitest run --config tests/config/vitest.unit.js",
    "test:integration": "node scripts/checks/integration-environment.js && vitest run --config tests/config/vitest.integration.js",
    "eval:smoke": "node scripts/evals/llm-eval.js --smoke",
    "eval:live": "node scripts/evals/llm-eval.js --live",
    "test:agent-live": "node scripts/evals/llm-eval.js",
    "test:bench": "node scripts/dev/live-convergence-bench.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "vitest": "^4.1.0"
  }
}
