# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET=your_supabase_service_role_secret

# Supabase integration tests (must be a separate, disposable test project)
SUPABASE_TEST_URL=https://your-test-project.supabase.co
SUPABASE_TEST_SECRET=your_test_project_service_role_secret

# Groq (optional: Whisper transcription only; GPT-OSS goes through OpenRouter)
GROQ_API_KEY=your_groq_api_key
AI_AUDIO_MODEL=whisper-large-v3-turbo

# OpenRouter (text, embeddings, images, documents, and audio fallback)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_PRIMARY_MODEL=openai/gpt-oss-120b
OPENROUTER_PRIMARY_PROVIDERS=groq
OPENROUTER_PRIMARY_REASONING_EFFORT=medium
OPENROUTER_PRIMARY_TIMEOUT_MS=9000
OPENROUTER_SECONDARY_MODEL=z-ai/glm-5.3-flash
OPENROUTER_SECONDARY_PROVIDERS=baseten/fp8
OPENROUTER_SECONDARY_REASONING_EFFORT=low
OPENROUTER_SECONDARY_TIMEOUT_MS=15000
OPENROUTER_LAST_RESORT_MODEL=qwen/qwen3.7-flash
OPENROUTER_LAST_RESORT_PROVIDERS=alibaba
OPENROUTER_LAST_RESORT_TIMEOUT_MS=12000
OPENROUTER_MEMORY_PRIMARY_MODEL=openai/gpt-oss-120b
OPENROUTER_MEMORY_PRIMARY_PROVIDERS=groq
OPENROUTER_MEMORY_PRIMARY_REASONING_EFFORT=low
OPENROUTER_MEMORY_PRIMARY_TIMEOUT_MS=9000
OPENROUTER_MEMORY_SECONDARY_MODEL=z-ai/glm-5.3-flash
OPENROUTER_MEMORY_SECONDARY_PROVIDERS=baseten/fp8
OPENROUTER_MEMORY_SECONDARY_TIMEOUT_MS=15000
OPENROUTER_VISION_MODEL=z-ai/glm-5.3-flash
OPENROUTER_VISION_PROVIDER=baseten/fp8
OPENROUTER_VISION_TIMEOUT_MS=15000
OPENROUTER_MAX_IMAGE_BYTES=20971520

# Kapso (WhatsApp Cloud API - Production Phone Number ID)
KAPSO_API_KEY=your_kapso_api_key
KAPSO_PHONE_NUMBER_ID=1248246475047194
KAPSO_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# MercadoPago (Recurring Subscriptions & Webhooks)
MP_ACCESS_TOKEN=your_mercadopago_access_token
MP_PLAN_ID=your_mercadopago_preapproval_plan_id
MP_WEBHOOK_SECRET=your_mercadopago_webhook_secret
APP_BASE_URL=https://hermes.templelabs.co

# Server
PORT=3005
