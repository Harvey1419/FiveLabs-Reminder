# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET=your_supabase_service_role_secret

# AI Groq (Primary Ultra-Fast Engine & Whisper Turbo for Audio)
AI_API_KEY=your_groq_api_key
AI_MODEL=openai/gpt-oss-20b
AI_AUDIO_MODEL=whisper-large-v3-turbo

# Google Gemini (High-Availability Backup / Fallback Engine)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite

# Kapso (WhatsApp Cloud API - Production Phone Number ID)
KAPSO_API_KEY=your_kapso_api_key
KAPSO_PHONE_NUMBER_ID=1248246475047194
KAPSO_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
WEBHOOK_SECRET_KEY=optional_webhook_hmac_secret

# MercadoPago (Recurring Subscriptions & Webhooks)
MP_ACCESS_TOKEN=your_mercadopago_access_token
MP_WEBHOOK_SECRET=your_mercadopago_webhook_secret
APP_BASE_URL=https://fivelabs-reminder-production.up.railway.app

# Server
PORT=3005